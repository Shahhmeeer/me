# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: the keys live in .env.local, never in the repo; .env.example
# lists the names with no values and is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# confidentiality: the forbidden client-name list is never committed
/.forbidden-end-client-names

# design references and source photos, kept on disk only and never committed;
# the committed references are under docs/references, never public
/public/portfolio-pallete.pdf
/public/images/reference*.png
/public/images/Me in Hoodie*.jpg
/docs/references/theme-reference.png
